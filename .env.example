# ---------------------------------------------------------------------------
# PMC Care credentials — YOUR OWN citizen account. Written for you by
# `python scripts/init.py`; you shouldn't need to edit this by hand.
# Nothing here is shipped with real values. Do NOT commit your filled-in .env.
# ---------------------------------------------------------------------------

# The mobile number your PMC Care citizen account is registered with.
# This is the only credential needed — login is OTP-only (no password).
# An OTP is texted to this number on first run; after that, the session is
# cached in .token_cache.json and reused for ~180 days before you're asked
# for another OTP.
PMCCARE_MOBILE="<your-10-digit-mobile>"

# Which PMC Care server to talk to. There is only one — you don't need to
# change this unless PMC moves their API to a different domain.
PMCCARE_BASE_URL="https://api.pmccare.in"
